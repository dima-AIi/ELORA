# ---------- Секреты ----------
# Ключ AI-консультанта (NVIDIA_API_KEY), токены Telegram-ботов и прочие
# секреты. В репозитории лежит только образец .env.example.
.env
.env.local
*.secrets.json

# ---------- Сборка ----------
bin/
obj/
.vs/
*.user
*.suo

# ---------- Данные ----------
# Рабочая база со записями клиентов: не коммитим, создаётся при первом
# запуске из Data/Sql/schema.sql.
*.db
*.db-shm
*.db-wal
App_Data/
/data/

# ---------- Прочее ----------
*.log
