@page
@model WorksModel
@{
    ViewData["Title"] = "Наши работы";
    ViewData["Description"] = "Портфолио студии ELORA: маникюр, педикюр, ресницы, брови, волосы и тату. Реальные результаты. Настоящие истории.";
}

<section class="page-hero">
    <div class="container">
        <div class="breadcrumbs">
            <a asp-page="/Index">Главная</a><span>/</span><span>Наши работы</span>
        </div>
        <h1 class="page-hero__title">Наши работы</h1>
        <p class="page-hero__sub">Реальные результаты. Настоящие истории. Фильтруйте по направлению, чтобы увидеть нужное.</p>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="works-filters" role="tablist" aria-label="Фильтр работ по категории">
            @foreach (var filter in Model.Filters)
            {
                <a class="works-filter @(filter.Key == Model.ActiveCategory ? "is-active" : "")"
                   role="tab"
                   aria-selected="@(filter.Key == Model.ActiveCategory ? "true" : "false")"
                   href="@(filter.Key == "all" ? Url.Page("/Works") : Url.Page("/Works", new { category = filter.Key }))">
                    @filter.Title<span class="works-filter__count">@filter.Count</span>
                </a>
            }
        </div>

        @if (Model.Works.Count == 0)
        {
            <div class="works-empty">
                В этой категории пока нет работ. Посмотрите <a href="/works">все работы</a>.
            </div>
        }
        else
        {
            <div class="works-page__grid" data-reveal>
                @foreach (var work in Model.Works)
                {
                    <article class="work-card">
                        <img src="@work.ImagePath" alt="@work.Title — @WorkCategories.Title(work.Category)"
                             loading="lazy" width="680" height="714" />
                        <div class="work-card__overlay">
                            <div class="work-card__title">@work.Title</div>
                            <div class="work-card__cat">
                                @WorkCategories.Title(work.Category)@(string.IsNullOrWhiteSpace(work.MasterName) ? "" : " · " + work.MasterName)
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="promo" data-reveal>
            <img class="promo__image" src="/images/promo/promo.jpg" alt="" loading="lazy" aria-hidden="true"
                 srcset="/images/promo/promo.jpg 1800w, /images/promo/promo-sm.jpg 900w"
                 sizes="(max-width: 768px) 100vw, 62vw" />
            <div class="promo__content">
                <h2 class="promo__title">Хотите так же?</h2>
                @* Скидки здесь тоже больше нет: то же обещание, что убрано с главной. *@
                <p class="promo__text">Онлайн-запись: выберите услугу и мастера, свободное время видно сразу</p>
                <div class="promo__cta">
                    <a class="btn" asp-page="/Booking">Записаться @Icons.Arrow(15)</a>
                </div>
            </div>
        </div>
    </div>
</section>
