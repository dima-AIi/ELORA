@page
@model AboutModel
@{
    ViewData["Title"] = "О нас";
    ViewData["Description"] = "Студия красоты ELORA: команда мастеров, подход к работе, цифры и отзывы клиентов.";
}

<section class="page-hero">
    <div class="container">
        <div class="breadcrumbs">
            <a asp-page="/Index">Главная</a><span>/</span><span>О нас</span>
        </div>
        <h1 class="page-hero__title">О студии</h1>
        <p class="page-hero__sub">
            ELORA — небольшая студия, где за каждым визитом стоит конкретный мастер,
            а не конвейер. Мы работаем по записи, чтобы вы не ждали в очереди.
        </p>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="stats-grid" data-reveal>
            <div class="stat-card">
                <div class="stat-card__value">@Model.Masters.Count</div>
                <div class="stat-card__label">мастера в команде</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__value">@Model.ServiceCount</div>
                <div class="stat-card__label">услуг в прайсе</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__value">@Model.Categories.Count</div>
                <div class="stat-card__label">направлений</div>
            </div>
            <div class="stat-card">
                <div class="stat-card__value">@Model.WorksCount</div>
                <div class="stat-card__label">работ в портфолио</div>
            </div>
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="section-head">
            <div class="section-head__text">
                <h2 class="section-title">Как мы работаем</h2>
                <p class="section-sub">Три принципа, из которых выросла вся студия</p>
            </div>
        </div>

        <div class="info-grid">
            <article class="card">
                <div class="info-card__icon">@Icons.UserCheck(18)</div>
                <div class="info-card__title">Свой мастер на каждый визит</div>
                <p class="info-card__text">
                    Вы выбираете мастера сами и остаётесь с ним: он помнит вашу форму ногтей,
                    изгиб брови и любимый оттенок. Никаких «кто сегодня свободен».
                </p>
            </article>

            <article class="card">
                <div class="info-card__icon">@Icons.Shield(18)</div>
                <div class="info-card__title">Честная запись без накладок</div>
                <p class="info-card__text">
                    Свободное время считает сервер по рабочим часам мастера и уже созданным
                    записям. Один слот — один клиент, пересечения исключены технически.
                </p>
            </article>

            <article class="card">
                <div class="info-card__icon">@Icons.Sparkle(18)</div>
                <div class="info-card__title">Материалы, которые носятся</div>
                <p class="info-card__text">
                    Работаем на профессиональных материалах и стерильном инструменте.
                    Если покрытие не дожило до трёх недель — переделаем бесплатно.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="section-head">
            <div class="section-head__text">
                <h2 class="section-title">Наши мастера</h2>
                <p class="section-sub">Узкая специализация вместо «делаю всё»</p>
            </div>
            <a class="link-arrow" asp-page="/Booking">Записаться @Icons.Arrow(15)</a>
        </div>

        <div class="masters-grid">
            @foreach (var master in Model.Masters)
            {
                <article class="master-card">
                    @* Фото мастера можно не ставить: снимок с фотостока нельзя выдавать
                       за сотрудника студии. Без него карточка показывает инициалы. *@
                    <div class="master-card__photo">
                        @if (!string.IsNullOrWhiteSpace(master.PhotoPath))
                        {
                            <img src="@master.PhotoPath" alt="@master.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="master-card__initials" aria-hidden="true">@Initials.From(master.Name)</span>
                        }
                    </div>
                    <div class="master-card__name">@master.Name</div>
                    @if (!string.IsNullOrWhiteSpace(master.Specialization))
                    {
                        <div class="master-card__spec">@master.Specialization</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(master.Description))
                    {
                        <p class="info-card__text" style="margin-top:8px;">@master.Description</p>
                    }
                </article>
            }
        </div>

        @* Мастера с фотографиями взяты из сида: люди на снимках — модели фотостока,
           и выдать их за сотрудников студии нельзя. Пометка стоит один раз под блоком,
           а не на каждой карточке: восемь одинаковых плашек читаются как мусор. *@
        @if (Model.Masters.Count > 0)
        {
            <p class="demo-note">
                Мастера и фотографии демонстрационные: на снимках модели фотостока, а не сотрудники студии.
            </p>
        }
    </div>
</section>

@if (Model.Reviews.Count > 0)
{
    <section class="section section--tight" id="reviews">
        <div class="container">
            <div class="section-head">
                <div class="section-head__text">
                    <h2 class="section-title">Что говорят клиенты</h2>
                </div>
                <a class="link-arrow" asp-page="/Booking">Записаться @Icons.Arrow(15)</a>
            </div>

            <div class="reviews__grid">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-card">
                        <div class="review-card__head">
                            @if (!string.IsNullOrWhiteSpace(review.AvatarPath))
                            {
                                <img class="review-card__avatar" src="@review.AvatarPath" alt="@review.ClientName" loading="lazy" width="40" height="40" />
                            }
                            else
                            {
                                <span class="review-card__initials" aria-hidden="true">@Initials.From(review.ClientName)</span>
                            }
                            <div>
                                <div class="review-card__name">
                                    @review.ClientName
                                    @if (Demo.IsReview(review.Text))
                                    {
                                        <span class="demo-badge" title="Отзыв добавлен для примера оформления">демо</span>
                                    }
                                </div>
                                <div class="stars">
                                    @for (var i = 0; i < review.Rating; i++)
                                    {
                                        @Icons.Star(11)
                                    }
                                </div>
                            </div>
                        </div>
                        <p class="review-card__text">@review.Text</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="section section--tight">
    <div class="container">
        <div class="promo" data-reveal>
            <img class="promo__image" src="/images/promo/promo.jpg" alt="" loading="lazy" aria-hidden="true"
                 srcset="/images/promo/promo.jpg 1800w, /images/promo/promo-sm.jpg 900w"
                 sizes="(max-width: 768px) 100vw, 62vw" />
            <div class="promo__content">
                <h2 class="promo__title">Приходите знакомиться</h2>
                <p class="promo__text">@Model.Address · @Model.WorkHours</p>
                <div class="promo__cta">
                    <a class="btn" asp-page="/Booking">Записаться онлайн @Icons.Arrow(15)</a>
                    <a class="btn btn--light" href="tel:@Model.Phone.Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "")">@Model.Phone</a>
                </div>
            </div>
        </div>
    </div>
</section>
