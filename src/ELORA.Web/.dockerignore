# Что не попадает в образ при сборке.
#
# Главное здесь — App_Data: в этой папке лежит рабочая база данных разработчика.
# Если её не исключить, она окажется внутри образа, и приложение на хостинге
# стартует с чужими тестовыми записями вместо чистой базы.

bin/
obj/
App_Data/
.vs/

# Любая база данных: рабочая база разработчика не должна попасть в образ.
*.db
*.db-shm
*.db-wal

# Локальные пользовательские настройки среды разработки
*.user
*.suo

# Секреты. Ключ AI-консультанта (NVIDIA_API_KEY) лежит в .env рядом с проектом —
# в образ он попадать не должен: образ публикуется в реестр, и секрет утёк бы
# вместе с ним. На хостинге ключ задаётся переменной окружения / секретом панели.
.env
.env.*
*.secrets.json

# Файлы, которые создаёт система контроля версий
.git/
.gitignore

# Сам Dockerfile и правила исключения незачем копировать внутрь образа
Dockerfile
.dockerignore
