# =====================================================================
#  ELORA — образец секретов для локального запуска.
#
#  Как пользоваться: скопируйте файл в .env рядом с ним и заполните.
#      cd ELORA.Web && cp .env.example .env
#  Файл .env в репозиторий не попадает (.gitignore) и в Docker-образ
#  тоже (.dockerignore) — секрет не утечёт ни туда, ни туда.
#
#  На хостинге (Fly.io, Render, Railway) файл не нужен: там те же
#  значения задаются штатными переменными окружения / секретами.
#  Окружение всегда главнее файла — если переменная уже задана, .env
#  её не перезапишет.
# =====================================================================

# ---------- AI-консультант (NVIDIA NIM) ----------
# Ключ выдаётся в каталоге NVIDIA: https://build.nvidia.com → Sign in →
# выбрать модель → «Get API Key». Ключ начинается с nvapi-.
# Пока ключ не задан, сайт работает, а консультант честно отвечает,
# что он ещё не подключён (HTTP 503) — вместо выдуманных ответов.
NVIDIA_API_KEY=

# Модель. Если оставить пустым, возьмётся первая из Ai:Models в appsettings.json.
# Список моделей каталога: https://integrate.api.nvidia.com/v1/models
# ВАЖНО: каталог общий для всех, а доступные модели у каждого ключа свои.
# Недоступная модель отвечает 404 «Not found for account» — на этот случай
# в appsettings.json задана цепочка Ai:Models: консультант перебирает модели
# по порядку, пока какая-нибудь не ответит.
NVIDIA_MODEL=

# ---------- Telegram ----------
# Токены ботов (@BotFather). Нужны только для уведомлений и Mini App.
# Обычно их держат в user-secrets, здесь — на случай запуска без них.
# Telegram__BotToken=
# Telegram__AdminBotToken=

# ---------- База данных ----------
# Пусто — база лежит в App_Data/elora.db рядом с приложением.
# Database__Path=
